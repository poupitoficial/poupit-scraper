--
-- O lado da app propos uma coluna search_vector em matched_products com
-- to_tsvector('portuguese', unaccent(name || brand)). Em vez de duas colunas
-- de pesquisa a fazer quase a mesma coisa (a nossa proposta original
-- "search_text" + a deles "search_vector"), esta migration ALARGA a
-- proposta deles: mesmo nome de coluna e tipo (tsvector, gerada, indexada
-- com GIN), so acrescenta category+subcategory a expressao de origem, para
-- pesquisas por categoria tambem funcionarem (ex. "limpeza casa de banho").
--
-- Resultado: fica so 1 coluna de pesquisa, nao duas.

create extension if not exists unaccent;

alter table public.matched_products add column if not exists search_vector tsvector
  generated always as (
    to_tsvector(
      'portuguese',
      unaccent(coalesce(name, '') || ' ' || coalesce(brand, '') || ' ' || coalesce(category, '') || ' ' || coalesce(subcategory, ''))
    )
  ) stored;

create index if not exists matched_products_search_vector_idx
  on public.matched_products using gin (search_vector);

